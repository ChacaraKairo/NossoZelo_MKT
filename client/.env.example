# NossoZelo Client - variaveis de ambiente
# Copie para .env apenas em desenvolvimento local.
# Em producao, configure estas variaveis diretamente no provedor de deploy.
# Variaveis NEXT_PUBLIC_* ficam embutidas no JavaScript publico do navegador.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Normalmente definido automaticamente pelo Next.js: development, production ou test.
# Configure manualmente apenas se o provedor de deploy exigir.
NODE_ENV=development

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Obrigatoria para build de producao.
# Local: http://localhost:4000
# Producao: use a URL HTTPS publica da API, sem barra final.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Timeout das requisicoes HTTP em milissegundos.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Logs do navegador
# -----------------------------------------------------------------------------
# Valores esperados: debug, info, warn, error.
NEXT_PUBLIC_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Login social
# -----------------------------------------------------------------------------
# true exibe login via Facebook nas telas de login.
NEXT_PUBLIC_ENABLE_FACEBOOK_LOGIN=false

# -----------------------------------------------------------------------------
# Redes sociais institucionais
# -----------------------------------------------------------------------------
# Deixe vazio para ocultar a rede social na interface.
NEXT_PUBLIC_NOSSOZELO_LINKEDIN_URL=
NEXT_PUBLIC_NOSSOZELO_INSTAGRAM_URL=
NEXT_PUBLIC_NOSSOZELO_FACEBOOK_URL=
