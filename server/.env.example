# NossoZelo API - variaveis de ambiente
# Copie para .env apenas em desenvolvimento local.
# Em producao, configure estas variaveis diretamente no provedor de deploy.
# Nunca versionar .env com valores reais.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=Nosso Zelo API
APP_VERSION=1.0.0

# Usado por alguns provedores, como Render, para expor a URL publica do servico.
# Se BACKEND_PUBLIC_URL estiver configurada, ela tem prioridade nas rotas internas.
RENDER_EXTERNAL_URL=

# -----------------------------------------------------------------------------
# Banco de dados e autenticacao
# -----------------------------------------------------------------------------
# Obrigatoria para build, runtime e Prisma.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nossozelo?schema=public

# Obrigatoria. Use pelo menos 32 caracteres em todos os ambientes.
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Opcional. Se informado, habilita testes de integracao com banco.
TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# URLs publicas, CORS e cookies
# -----------------------------------------------------------------------------
# FRONTEND_URL: URL publica do client.
# BACKEND_PUBLIC_URL: URL publica desta API.
# API_URL: fallback legado usado em callbacks e inicializacao.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
API_URL=http://localhost:4000

# Obrigatoria em producao. Separe multiplas origens por virgula.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Valores aceitos: lax, strict, none. Em producao cross-site, use none.
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Logs e integracoes externas
# -----------------------------------------------------------------------------
# LOG_FORMAT: pretty ou json.
LOG_LEVEL=info
LOG_FORMAT=pretty

# Obrigatorio para uso educado da API do Nominatim.
NOMINATIM_USER_AGENT=NossoZelo/1.0 (contato@nossozelo.com.br)
EXTERNAL_FETCH_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Rate limit
# -----------------------------------------------------------------------------
# Em producao, RATE_LIMIT_STORE=upstash e as credenciais abaixo sao obrigatorias.
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# E-mail transacional
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=NossoZelo <no-reply@example.com>

# -----------------------------------------------------------------------------
# Pagamentos / Assinaturas
# -----------------------------------------------------------------------------
# Em producao, PAYMENT_GATEWAY=asaas e credenciais Asaas sao obrigatorias.
# Para desenvolvimento sem cobranca real, use PAYMENT_GATEWAY=disabled.
PAYMENT_GATEWAY=disabled

# Valor padrao da assinatura quando o plano nao trouxer valor do banco.
# Exemplo: 99.90
ASSINATURA_VALOR=

# ASAAS_ENVIRONMENT: sandbox ou production.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_BILLING_TYPE=PIX
ASAAS_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Login social
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/nossozelo/login/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/nossozelo/login/social/facebook/callback

# -----------------------------------------------------------------------------
# Admin interno e uploads
# -----------------------------------------------------------------------------
# ENABLE_ADMIN_CRUD=true libera rotas CRUD administrativas em producao.
ENABLE_ADMIN_CRUD=false

# ENABLE_UPLOADS=true exige configuracao AWS abaixo.
ENABLE_UPLOADS=false

# UPLOAD_SCAN_MODE: disabled ou clamav. Em producao com uploads, use clamav.
UPLOAD_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Banco Aiven / keep-alive
# -----------------------------------------------------------------------------
# true: forca keep-alive; false: desliga; vazio: automatico para Aiven em producao.
ENABLE_AIVEN_KEEP_ALIVE=

# -----------------------------------------------------------------------------
# Seed administrativo
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador NossoZelo
SEED_ADMIN_CPF=
SEED_ADMIN_PHONE=
SEED_ADMIN_CEP=00000000

# -----------------------------------------------------------------------------
# Scripts de backup e restore
# -----------------------------------------------------------------------------
# BACKUP_DIR: diretorio onde backups serao salvos.
# BACKUP_FILE: arquivo usado pelo restore quando nenhum caminho for passado via CLI.
BACKUP_DIR=
BACKUP_FILE=

# -----------------------------------------------------------------------------
# Variaveis extras / compatibilidade
# -----------------------------------------------------------------------------
# BACKEND_PUBLIC_UR parece ser um typo de BACKEND_PUBLIC_URL.
# Mantenha vazio em novas configuracoes e use BACKEND_PUBLIC_URL.
BACKEND_PUBLIC_UR=

# URLs auxiliares para alternar ambientes manualmente, se necessario.
# O codigo atual usa DATABASE_URL.
DATABASE_URL_LOCAL=
DATABASE_URL_DOCKER=

# O codigo atual nao le estas variaveis diretamente.
# Mantenha apenas se houver integracao externa/deploy dependendo delas.
JWT_EXPIRATION=
LOCALHOST=
LINK=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
