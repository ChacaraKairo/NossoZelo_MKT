# NossoZelo Controlador - variaveis de ambiente
# Copie para .env apenas em desenvolvimento local.
# Em producao, configure estas variaveis diretamente no provedor de deploy.
# Nunca versionar .env com valores reais.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Nome exibido no painel. NEXT_PUBLIC_* fica embutida no JavaScript publico.
NEXT_PUBLIC_APP_NAME=Controlador NossoZelo

# URL HTTPS publica do controlador/admin, sem barra final.
# Usada para validar origem de POST/PUT/PATCH/DELETE em producao.
CONTROLADOR_PUBLIC_URL=http://localhost:3001

# Origens extras autorizadas para chamadas administrativas.
# Use apenas quando houver proxy/domínio adicional do painel.
ADMIN_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Obrigatoria para build, runtime e Prisma.
DATABASE_URL=mysql://usuario:senha@localhost:3306/nossozelo

# -----------------------------------------------------------------------------
# Sessao administrativa
# -----------------------------------------------------------------------------
# Obrigatoria. Use pelo menos 32 caracteres.
JWT_ADMIN_SECRET=troque-por-uma-chave-admin-com-pelo-menos-32-caracteres

# Obrigatoria em producao. E-mail do administrador mestre.
MASTER_ADMIN_EMAIL=master@master.master

# -----------------------------------------------------------------------------
# Rotinas agendadas
# -----------------------------------------------------------------------------
# Obrigatoria para chamar endpoints de cron.
# Enviar no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=troque-por-um-segredo-cron-com-pelo-menos-32-caracteres

# -----------------------------------------------------------------------------
# Asaas e assinaturas
# -----------------------------------------------------------------------------
# ASAAS_ENVIRONMENT: sandbox ou production.
# Em production, nao use URL nem chave de sandbox.
PAYMENT_GATEWAY=asaas
ASSINATURA_VALOR=
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_BILLING_TYPE=PIX
